# Google Cloud Console에서 Cloud Vision API로 사용 범위를 제한한 서버 전용 키입니다.
# 비워 두면 웹 후보 수집 API는 준비되지 않은 상태를 명확히 반환합니다.
GOOGLE_VISION_API_KEY=

# InsightFace buffalo_l 가중치의 비상업 연구 조건을 직접 확인한 뒤에만 true로 바꿉니다.
FACEGUARD_ACCEPT_NONCOMMERCIAL_MODEL_LICENSE=false

# 로컬 데모는 CPU가 가장 간단합니다. NVIDIA Docker 환경에서는 cuda로 바꿀 수 있습니다.
FACEGUARD_DEVICE=cpu
FACEGUARD_DEEPFAKE_DEVICE=cpu

# 서버가 모델 API 응답을 기다리는 최대 시간입니다.
FACEGUARD_MODEL_API_TIMEOUT_SECONDS=30

