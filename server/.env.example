# Google Cloud Vision Web Detection 전용 API 키.
# 키는 클라이언트 코드에 넣지 말고, Google Cloud에서 Cloud Vision API로 사용 범위를 제한한다.
# 새 /api/faceguard/scans 경로는 키가 없거나 호출에 실패하면 가짜 후보로 폴백하지 않는다.
GOOGLE_VISION_API_KEY=

# 모노레포 services/faceguard-model-api의 내부 주소. 기존 서버는 8000,
# 모델 API는 8001 포트를 권장한다.
FACEGUARD_MODEL_API_URL=http://127.0.0.1:8001
FACEGUARD_MODEL_API_TIMEOUT_SECONDS=30
