# Google Cloud Vision API 키. 없으면 얼굴가드는 시뮬레이션 데이터로 자동 폴백한다.
# (참고: https://github.com/BcKmini/copycat-watch 의 GOOGLE_VISION_API_KEY와 동일한 키)
GOOGLE_VISION_API_KEY=

# 모노레포 services/faceguard-model-api의 로컬 주소. 기존 서버는 8000,
# 모델 API는 8001 포트를 사용한다.
FACEGUARD_MODEL_API_URL=http://127.0.0.1:8001
FACEGUARD_MODEL_API_TIMEOUT_SECONDS=30
